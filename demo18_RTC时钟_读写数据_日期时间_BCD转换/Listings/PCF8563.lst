  58          void PCF8563_get_Clock(Clock_t * c) {
  59   1          u8 p[NUMBER] = {0};
  60   1          u8 C;
  61   1          
  62   1          I2C_ReadNbyte(PCF8563_ADDR, PCF8563_REG, p, NUMBER);
