   8          /*
   9          串口通讯测试 —— 双设备 UART 互联(透传)
  10          
  11          硬件连接:
  12            1. PC串口A 接 设备A 的 UART1 (P3.0/P3.1)
  13               PC串口B 接 设备B 的 UART1 (P3.0/P3.1)
  14            2. 设备A 的 UART4 (P5.2/P5.3) 与 设备B 的 UART4 交叉相连:
  15               A_RXD(P5.2) <-- B_TXD(P5.3)
  16               A_TXD(P5.3) --> B_RXD(P5.2)
  17               两板 GND 相连
  18          
  19          功能:
  20            a. 从 UART1 收到 PC 发来的数据, 原样从 UART4 转发出去
  21            b. 从 UART4 收到另一台设备发来的数据, 原样从 UART1 转发出去
  22          
  23          A、B 两台设备烧录同一份程序。
  24          默认波特率: 115200, N, 8, 1
  25          */
  26          
  27          /******************* IO配置函数 *******************/
  28          void    GPIO_config(void)
  29          {
  30   1              GPIO_InitTypeDef        GPIO_InitStructure;             //结构定义
  31   1      
  32   1              // 串口1的 P3.0(RXD), P3.1(TXD) 配置为准双向口(上拉)
  33   1              GPIO_InitStructure.Pin  = GPIO_Pin_0 | GPIO_Pin_1;      //指定要初始化的IO
  34   1              GPIO_InitStructure.Mode = GPIO_PullUp;                          //上拉准双向口
  35   1              GPIO_Inilize(GPIO_P3, &GPIO_InitStructure);                     //初始化P3口
  36   1      
  37   1              // 串口4的 P5.2(RXD), P5.3(TXD) 配置为准双向口(上拉)
  38   1              GPIO_InitStructure.Pin  = GPIO_Pin_2 | GPIO_Pin_3;
  39   1              GPIO_InitStructure.Mode = GPIO_PullUp;
  40   1              GPIO_Inilize(GPIO_P5, &GPIO_InitStructure);                     //初始化P5口
  41   1      }
  42          
  43          /***************  串口初始化函数 *****************/
  44          void    UART_config(void)
  45          {
  46   1              COMx_InitDefine         COMx_InitStructure;                                     //结构定义
  47   1      
  48   1              //---------- 串口1: 连接PC ----------
