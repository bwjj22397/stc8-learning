  36              0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90,
  37              // 0. 1. 2. -> 9.   (索引10,11,12....19)
  38              0x40, 0x79, 0x24, 0x30, 0x19, 0x12, 0x02, 0x78, 0x00, 0x10,
  39              // . -                      (索引20,21)
  40              0x7F, 0xBF,
  41              // AbCdEFHJLPqU     (索引22,23,24....33)
  42              0x88, 0x83, 0xC6, 0xA1, 0x86, 0x8E, 0x89, 0xF1, 0xC7, 0x8C, 0x98, 0xC1
  43          };
  44          
  45          void Nixie_Operation(u8 Nixie_Index, u8 Switch_Index) {
  46   1          NIXIE_DATA_OUTPUT(LED_TABLE[Nixie_Index]);
  47   1      
  48   1          NIXIE_DATA_OUTPUT(1 << Switch_Index);
  49   1      
  50   1          NIXIE_RCK_OPERATION;
