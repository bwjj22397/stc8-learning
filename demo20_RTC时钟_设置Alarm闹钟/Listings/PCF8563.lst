  40          void PCF8563_set_Clock(Clock_t c) {
  41   1          u8 p[TIME_NUMBER] = {0};
  42   1          u8 C;
  43   1          
  44   1          p[0] = ((c.seconds / 10) << 4) | (c.seconds % 10);
  45   1          p[1] = ((c.minutes / 10) << 4) | (c.minutes % 10);
  46   1          p[2] = ((c.hours / 10) << 4)   | (c.hours % 10);
  47   1          p[3] = ((c.days / 10) << 4)    | (c.days % 10);
  48   1          p[4] = c.weekdays;
  49   1          
  50   1          C = (c.years >= 2100) ? 1 : 0;
  51   1          
  52   1          p[5] = (C << 7) |((c.months / 10) << 4)  | (c.months % 10);
  53   1          p[6] = ((c.years % 100 / 10) << 4) | (c.years % 10);
C51 COMPILER V9.60.7.0   PCF8563                                                           08/28/2026 11:24:48 PAGE 2   

  54   1          
  55   1          I2C_WriteNbyte(PCF8563_ADDR, PCF8563_REG, p, TIME_NUMBER);
  56   1      }
  57          
  58          void PCF8563_get_Clock(Clock_t * c) {
  59   1          u8 p[TIME_NUMBER] = {0};
  60   1          u8 C;
  61   1          
  62   1          I2C_ReadNbyte(PCF8563_ADDR, PCF8563_REG, p, TIME_NUMBER);
  63   1          
  64   1          c->seconds  = ((p[0] >> 4)& 0x07) * 10 + (p[0] & 0x0F);
  65   1          c->minutes  = ((p[1] >> 4)& 0x07) * 10 + (p[1] & 0x0F);
  66   1          c->hours    = ((p[2] >> 4)& 0x03) * 10 + (p[2] & 0x0F);
  67   1          c->days     = ((p[3] >> 4)& 0x03) * 10 + (p[3] & 0x0F);
  68   1          c->weekdays = p[4];
  69   1          c->months   = ((p[5] >> 4)& 0x01) * 10 + (p[5] & 0x0F);
  70   1          c->years    = ((p[6] >> 4)& 0x0F) * 10 + (p[6] & 0x0F);
  71   1          
  72   1          C = p[5] & 0x80;
  73   1          
  74   1          c->years += (C == 0) ? 2000 : 2100;
  75   1      }
