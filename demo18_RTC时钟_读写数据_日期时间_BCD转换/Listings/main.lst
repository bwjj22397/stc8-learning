  13          /*************************************************************************************
  14          RTC时钟
  15          
  16          1. 通过I2C外设(协议)读取PCF8563芯片数据(16字节)
  17              - 开启扩展寄存器访问使能 EAXSFR()
  18              - 引脚模式: 开漏输出模式 Open 1, Drain 0
  19              - I2C协议(一对多)
  20              
  21          2. 引脚
  22              - SCL: P3.2 时钟线   (Serial Clock)
  23              - SDA: P3.3 数据线   (Serial Data)
  24              - INT: P3.7 下降沿
  25              
  26          读取芯片里的年月日, 时分秒(世纪, 周)
  27          
  28          *************************************************************************************/
  29          
  30          void    GPIO_config(void) {
  31   1          GPIO_InitTypeDef    GPIO_InitStructure;
  32   1          GPIO_InitStructure.Pin  = GPIO_Pin_0 | GPIO_Pin_1;          //指定要初始化的IO,
  33   1          GPIO_InitStructure.Mode = GPIO_PullUp;          //指定IO的输入或输出方式,GPIO_PullUp,GPIO_HighZ,GPIO_OUT_OD
             -,GPIO_OUT_PP
  34   1          GPIO_Inilize(GPIO_P3, &GPIO_InitStructure);//初始化
  35   1      }
