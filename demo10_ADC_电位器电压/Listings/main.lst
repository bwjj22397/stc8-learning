  52   1              ADC_PowerControl(ENABLE);                               //ADC电源开关, ENABLE或DISABLE
  53   1              NVIC_ADC_Init(DISABLE,Priority_0);              //中断使能, ENABLE/DISABLE; 优先级(低到高) Priority_0,Priority_1,Prio
