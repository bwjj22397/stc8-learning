  64   1          c->seconds  = ((p[0] >> 4)& 0x07) * 10 + (p[0] & 0x0F);
  65   1          c->minutes  = ((p[1] >> 4)& 0x07) * 10 + (p[1] & 0x0F);
  66   1          c->hours    = ((p[2] >> 4)& 0x03) * 10 + (p[2] & 0x0F);
  67   1          c->days     = ((p[3] >> 4)& 0x03) * 10 + (p[3] & 0x0F);
  68   1          c->weekdays = p[4];
  69   1          c->months   = ((p[5] >> 4)& 0x01) * 10 + (p[5] & 0x0F);
  70   1          c->years    = ((p[6] >> 4)& 0x0F) * 10 + (p[6] & 0x0F);
  71   1          
  72   1          C = p[5] & 0x80;
  73   1          
  74   1          c->years += (C == 0) ? 2000 : 2100;
  75   1      }


