 103          void PCF8563_enable_Alarm(u8 enable) {
 104   1          u8 enAlarm;
 105   1          
 106   1          I2C_ReadNbyte(PCF8563_ADDR, PCF8563_ENALARM, &enAlarm, 1);
 107   1          
 108   1          // AF -> 清理Alarm中断标记 Alarm Flag Bit3清0, 确保闹铃中断触发
 109   1          enAlarm &= ~(1 << 3);
 110   1          // AIE-> 开启Alarm中断 Bit1置1, Alarm Interrupt Enable
 111   1          if(enable) {
 112   2              enAlarm |=  (1 << 1);
 113   2          } else {
 114   2              enAlarm &= ~(1 << 1);
 115   2          }
