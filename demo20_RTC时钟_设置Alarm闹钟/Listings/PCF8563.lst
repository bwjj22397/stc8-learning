  10          /****************  I2C初始化函数 *****************/
  11          void I2C_config(void)
  12          {
  13   1              I2C_InitTypeDef         I2C_InitStructure;
  14   1      
  15   1              I2C_InitStructure.I2C_Mode      = I2C_Mode_Master;      // 主从选择   I2C_Mode_Master, I2C_Mode_Slave
  16   1              I2C_InitStructure.I2C_Enable    = ENABLE;                       // I2C功能使能,   ENABLE, DISABLE
  17   1              I2C_InitStructure.I2C_MS_WDTA   = DISABLE;                      // 主机使能自动发送,  ENABLE, DISABLE
  18   1              I2C_InitStructure.I2C_Speed     = 13;                           // 总线速度=Fosc/2/(Speed*2+4),      0~63
  19   1          /*                                           速度 =  24M / 2 / (16 * 2 + 4)
  20   1                                                       速度 =  12M / 36  = 333.3Kbit/s
  21   1                                                          
  22   1                                                       400 = 12K / (Speed * 2 + 4)
  23   1                                                       400Kbit/s -> 13
  24   1                                                       100Kbit/s -> 58
  25   1          */
  26   1              I2C_Init(&I2C_InitStructure);
  27   1          
  28   1              NVIC_I2C_Init(I2C_Mode_Master,DISABLE,Priority_0);      //主从模式, I2C_Mode_Master, I2C_Mode_Slave; 中断使能,
             - ENABLE/DISABLE; 优先级(低到高) Priority_0,Priority_1,Priority_2,Priority_3
  29   1      
  30   1          // 引脚选择
  31   1              I2C_SW(I2C_P33_P32);                                    //I2C_P14_P15,I2C_P24_P25,I2C_P33_P32
  32   1      }
