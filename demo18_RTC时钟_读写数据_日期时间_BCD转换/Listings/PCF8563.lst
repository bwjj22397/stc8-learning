  23   1                                                       400Kbit/s -> 13
  24   1                                                       100Kbit/s -> 58
  25   1          */
  26   1              I2C_Init(&I2C_InitStructure);
  27   1          
  28   1              NVIC_I2C_Init(I2C_Mode_Master,DISABLE,Priority_0);      //主从模式, I2C_Mode_Master, I2C_Mode_Slave; 中断使能,
