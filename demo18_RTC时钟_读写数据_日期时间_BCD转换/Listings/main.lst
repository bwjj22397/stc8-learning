  63   1              /*****************************************
  64   1          两个地址:
  65   1          dev_addr: 设备地址, 决定了I2C和哪个设备通讯(device address)
  66   1              - 设备地址:   0x51 (7bit)
  67   1              - 设备读地址：0xA3;  (0x51 << 1) | 1
  68   1              - 设备写地址：0xA2;  (0x51 << 1)
  69   1          
  70   1          mem_addr: 存储地址, 决定了I2C和该设备的哪个寄存器register交互(memory address)
  71   1              - 用于指定从哪个寄存器开始读写数据
  72   1              - 每次读写数据字节后，寄存器地址自动累加。
  73   1          
  74   1          u8 *p   : 读写数据缓冲区
  75   1          number  : 读写的数据个数
  76   1          ******************************************/
  77   1          c.years = 2099, c.months = 12, c.days = 31, c.weekdays = 4;
  78   1          c.hours = 23, c.minutes = 59, c.seconds = 55;
  79   1          
  80   1          PCF8563_set_Clock(c);
  81   1          
  82   1          while (1) {
  83   2              PCF8563_get_Clock(&c);
  84   2              
  85   2              // BCD格式数据, 要用16进制打印
  86   2              // 年-月-日
  87   2              printf("%04d-%02d-%02d\n", (int)c.years, (int)c.months, (int)c.days);
  88   2              // 时:分:秒
  89   2              printf("%02d:%02d:%02d\n", (int)c.hours, (int)c.minutes, (int)c.seconds);
  90   2              // week
  91   2              printf("week->%d\n", (int)c.weekdays);
  92   2              
  93   2              delay_ms(250);
  94   2              delay_ms(250);
  95   2              delay_ms(250);
  96   2              delay_ms(250);
  97   2          }
