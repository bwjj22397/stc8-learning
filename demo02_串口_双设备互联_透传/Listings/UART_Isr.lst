  15          //========================================================================
  16          // 函数: UART1_ISR_Handler
  17          // 描述: UART1中断函数.
  18          // 参数: none.
  19          // 返回: none.
  20          // 版本: V1.0, 2020-09-23
  21          // 在发送或接收到任何1个字节时, 此函数(中断函数)会立即打断main并执行
  22          //========================================================================
  23          #ifdef UART1
  24          void UART1_ISR_Handler (void) interrupt UART1_VECTOR
  25          {
  26   1              if(RI)
  27   1              {
  28   2                      RI = 0;
  29   2      
  30   2              // 超过缓冲区大小, 自动从头覆盖
  31   2              if(COM1.RX_Cnt >= COM_RX1_Lenth)        COM1.RX_Cnt = 0;
  32   2              
  33   2              // 将接收寄存器里的数据, 存放到Buffer数组里, 位置会自动增长
  34   2              RX1_Buffer[COM1.RX_Cnt++] = SBUF;
  35   2              
  36   2              // 将超时时间重置为5, 开始倒计时
  37   2              COM1.RX_TimeOut = TimeOutSet1;
  38   2              }
  39   1      
  40   1              if(TI)
  41   1              {
  42   2                      TI = 0;
  43   2                      
  44   2              #if(UART_QUEUE_MODE == 1)   //判断是否使用队列模式
                              if(COM1.TX_send != COM1.TX_write)
                              {
                                      SBUF = TX1_Buffer[COM1.TX_send];
                                      if(++COM1.TX_send >= COM_TX1_Lenth)             COM1.TX_send = 0;
                              }
                              else    COM1.B_TX_busy = 0;
                      #else
  52   2              COM1.B_TX_busy = 0;     //使用阻塞方式发送直接清除繁忙标志
  53   2              #endif
  54   2              }
C51 COMPILER V9.60.7.0   UART_ISR                                                          08/19/2026 16:44:18 PAGE 2   

  55   1      }
  56          #endif
