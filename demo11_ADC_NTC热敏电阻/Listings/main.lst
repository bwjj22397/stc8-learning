 242          int search_temp(float ntc_Rx100) {
 243   1          int min_index = 0, i = 0;
 244   1          // ¼ÇÂ¼×îÐ¡¾àÀë
 245   1          float min_distance = ABS(ntc_Rx100 - temp_table[0]);
 246   1          // ¼ÆËãÊý×é³¤¶È
 247   1          int len = sizeof(temp_table) / sizeof(temp_table[0]);
 248   1      
 249   1          for (i = 1; i < len; i++) {
 250   2              // Öð¸ö¼ÆËã ntc_Rx100 ºÍÃ¿¸öÊýµÄ¾àÀë(Çó¾ø¶ÔÖµ)
 251   2              float distance = ABS(ntc_Rx100 - temp_table[i]);
 252   2      
 253   2              // ÅÐ¶ÏÊÇ·ñ¾àÀë¸ü½ü
 254   2              if (distance < min_distance) {
 255   3                  // ¼ÇÂ¼¸ü½üµÄ¾àÀë
 256   3                  min_distance = distance;
 257   3                  // ¼ÇÂ¼Ë÷ÒýÎ»ÖÃ
 258   3                  min_index = i;
 259   3              }
 260   2      //      printf("¾àÀë[%d] -> %.1f index: %d\n", temp_table[i], distance, (int)i);
 261   2          }
 262   1      
 263   1          return min_index;
 264   1      }
