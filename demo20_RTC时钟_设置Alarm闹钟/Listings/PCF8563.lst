  77          void PCF8563_set_Alarm(Alarm_t a) {
  78   1          //默认所有时间单位都禁用
  79   1          u8 alarm[ALARM_NUMBER] = {0x80, 0x80, 0x80, 0x80};
  80   1          
  81   1          // 设置闹铃 --------------------------------------------------------------
  82   1          // 设置闹铃时间: 09h分钟, 0Ah小时, 0Bh天, 0Ch周 (最高0: 启动)
  83   1          // 分:  M 1 1 1 - 0 0 0 0 十进制数 -> BCD 最高位 启用 &(~0x10), 禁用 |0x80
  84   1          if(a.alarm_minute >= 0) {
  85   2              alarm[0] = (~0x10) & ((a.alarm_minute / 10) << 4) | (a.alarm_minute % 10);
  86   2          }
  87   1          
  88   1          if(a.alarm_hour >= 0) {
  89   2              alarm[1] = (~0x10) & ((a.alarm_hour / 10) << 4) | (a.alarm_hour % 10);
  90   2          }
  91   1          
  92   1          if(a.alarm_day >= 0) {
  93   2              alarm[2] = (~0x10) & ((a.alarm_day / 10) << 4) | (a.alarm_day % 10);
  94   2          }
  95   1          
  96   1          if(a.alarm_week >= 0) {
  97   2              alarm[3] = (~0x10) & a.alarm_week;
  98   2          }
  99   1          
 100   1          I2C_WriteNbyte(PCF8563_ADDR, PCF8563_ALARM, alarm, ALARM_NUMBER);
 101   1      }
