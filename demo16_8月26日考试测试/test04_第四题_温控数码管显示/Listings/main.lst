 260          int search_temp(float ntc_Rx100) {
 261   1          int min_index = 0, i = 0;
 262   1          // ¼ÇÂ¼×îÐ¡¾àÀë
 263   1          float min_distance = ABS(ntc_Rx100 - temp_table[0]);
 264   1          // ¼ÆËãÊý×é³¤¶È
 265   1          int len = sizeof(temp_table) / sizeof(temp_table[0]);
 266   1      
 267   1          for (i = 1; i < len; i++) {
 268   2              // Öð¸ö¼ÆËã ntc_Rx100 ºÍÃ¿¸öÊýµÄ¾àÀë(Çó¾ø¶ÔÖµ)
 269   2              float distance = ABS(ntc_Rx100 - temp_table[i]);
 270   2      
 271   2              // ÅÐ¶ÏÊÇ·ñ¾àÀë¸ü½ü
 272   2              if (distance < min_distance) {
 273   3                  // ¼ÇÂ¼¸ü½üµÄ¾àÀë
 274   3                  min_distance = distance;
 275   3                  // ¼ÇÂ¼Ë÷ÒýÎ»ÖÃ
 276   3                  min_index = i;
 277   3              }
 278   2      //      printf("¾àÀë[%d] -> %.1f index: %d\n", temp_table[i], distance, (int)i);
 279   2          }
 280   1      
 281   1          return min_index;
 282   1      }
