  14          #define NIXIE_DATA_OUTPUT(byte) do{     \
  15                  int8 i;                         \
  16                  for (i = 7; i >= 0; i--) {      \
  17                  NIX_DI = get_Value(byte, i);    \
  18                  NIX_SCK = 0;                    \
