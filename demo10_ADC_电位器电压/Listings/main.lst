  34          /******************* AD配置函数 *******************/
  35          void    ADC_config(void)
  36          {
  37   1              ADC_InitTypeDef         ADC_InitStructure;              //结构定义
  38   1      
  39   1          // 通过输入引脚给电容充电, 时间够长, 才能确保电容电压和外部输入电压一致
  40   1              ADC_InitStructure.ADC_SMPduty   = 31;           //ADC 模拟信号采样时间控制, 0~31（注意： SMPDUTY 一定不能设置小于 
             -10）
  41   1          
  42   1          // 内部多个通道选择, 需要一段时间稳定(1个ADC时钟 n+1)
  43   1              ADC_InitStructure.ADC_CsSetup   = 0;            //ADC 通道选择时间控制 0(默认),1
  44   1          
  45   1          // 在真正采样之前, 需要保持一段时间(2个ADC时钟 n+1)
  46   1              ADC_InitStructure.ADC_CsHold    = 1;            //ADC 通道选择保持时间控制 0,1(默认),2,3
  47   1          
  48   1          // 配置速度 2X1T 最快, 可能会损失精度
  49   1              ADC_InitStructure.ADC_Speed     = ADC_SPEED_2X16T;              //设置 ADC 工作时钟频率 ADC_SPEED_2X1T~ADC_SPEED_2X16
             -T
  50   1              ADC_InitStructure.ADC_AdjResult = ADC_RIGHT_JUSTIFIED;  //ADC结果调整,  ADC_LEFT_JUSTIFIED,ADC_RIGHT_JUSTIF
             -IED
  51   1              ADC_Inilize(&ADC_InitStructure);                //初始化
