 294          int search_temp(float ntc_Rx100) {
 295   1          int min_index = 0, i = 0;
 296   1          // ¼ÇÂ¼×îÐ¡¾àÀë
 297   1          float min_distance = ABS(ntc_Rx100 - temp_table[0]);
 298   1          // ¼ÆËãÊý×é³¤¶È
 299   1          int len = sizeof(temp_table) / sizeof(temp_table[0]);
 300   1      
 301   1          for (i = 1; i < len; i++) {
 302   2              // Öð¸ö¼ÆËã ntc_Rx100 ºÍÃ¿¸öÊýµÄ¾àÀë(Çó¾ø¶ÔÖµ)
 303   2              float distance = ABS(ntc_Rx100 - temp_table[i]);
 304   2      
 305   2              // ÅÐ¶ÏÊÇ·ñ¾àÀë¸ü½ü
 306   2              if (distance < min_distance) {
 307   3                  // ¼ÇÂ¼¸ü½üµÄ¾àÀë
 308   3                  min_distance = distance;
 309   3                  // ¼ÇÂ¼Ë÷ÒýÎ»ÖÃ
 310   3                  min_index = i;
 311   3              }
 312   2      //      printf("¾àÀë[%d] -> %.1f index: %d\n", temp_table[i], distance, (int)i);
 313   2          }
 314   1      
 315   1          return min_index;
 316   1      }
